generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Schedule {
  id          Int        @id @default(autoincrement())
  dayOfWeek   Int        
  startTime   String     
  endTime     String     
  title       String    
  type        String     
  logs        StudyLog[]
}

model StudyLog {
  id             Int               @id @default(autoincrement())
  scheduleId     Int
  schedule       Schedule          @relation(fields: [scheduleId], references: [id])
  date           DateTime          @default(now())
  actualStartAt  DateTime?
  delayMinutes   Int               @default(0)
  status         String            @default("IN_PROGRESS")
  actionLogs     StudyActionLog[]  
  createdAt      DateTime          @default(now())
}

enum StudyActionType {
  START_ON_TIME 
  START_LATE   
  PAUSE         
  RESUME        
  TAKE_NOTE     
  END_SESSION   
}

model StudyActionLog {
  id          Int             @id @default(autoincrement())
  studyLogId  Int
  studyLog    StudyLog        @relation(fields: [studyLogId], references: [id])
  time        DateTime        @default(now())
  
  action      StudyActionType 
  
  note        String?         @db.Text
  images      NoteImage[]
}

model NoteImage {
  id          Int       @id @default(autoincrement())
  url         String   
  createdAt   DateTime  @default(now())

  actionLogId Int
  actionLog   StudyActionLog @relation(fields: [actionLogId], references: [id], onDelete: Cascade)
}

model Subject {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  fullScore   Float      
  mockTests   MockTest[]
  resources   Resource[]
}

model MockTest {
  id          Int      @id @default(autoincrement())
  
  subjectId   Int
  subject     Subject  @relation(fields: [subjectId], references: [id])
  
  score       Float    
  timeSpent   Int    
  testDate    DateTime @default(now())
  notes       String?  @db.Text
}

model Resource {
  id        Int      @id @default(autoincrement())
  subjectId Int
  title     String
  type      ResourceType
  url       String?  
  content   String? 
  createdAt DateTime @default(now())

  subject   Subject  @relation(fields: [subjectId], references: [id])
}

enum ResourceType {
  VIDEO
  DOCUMENT
  LINK
  NOTE
}